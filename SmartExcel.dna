<?xml version="1.0" encoding="utf-8"?>
<DnaLibrary Name="SmartExcel Add-In" RuntimeVersion="v4.0">
  <ExternalLibrary Path="SmartExcel.dll" ExplicitExports="false" LoadFromBytes="false" Pack="false" />
  
  <CustomUI>
    <customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui">
      <ribbon>
        <tabs>
          <tab id="SmartExcelTab" label="SmartExcel">
            <group id="SmartExcelGroup" label="Data Tools">
                    <button id="SplitRowsButton" 
                      label="Split Rows" 
                      size="large" 
                      onAction="OnSplitRowsButton"
                      screentip="Split delimiter-separated values"
                      supertip="Split the selected column into multiple rows by a chosen delimiter while duplicating the rest of the row data."
                      getImage="GetSplitRowsImage" />
                    <button id="ChangeDelimiterButton" 
                      label="Change Delimiter" 
                      size="large" 
                      onAction="OnChangeDelimiterButton"
                      screentip="Replace delimiters in a column"
                      supertip="Swap one delimiter for another across the selected column, with support for common and custom delimiters."
                      getImage="GetChangeDelimiterImage" />
                    <button id="TrimColumnButton" 
                      label="TRIM rows" 
                      size="large" 
                      onAction="OnTrimColumnButton"
                      screentip="Trim spaces from a column"
                      supertip="Remove leading, trailing, or both types of whitespace from every cell in the selected column."
                      getImage="GetTrimColumnImage" />
            </group>
          </tab>
        </tabs>
      </ribbon>
    </customUI>
  </CustomUI>
</DnaLibrary>
